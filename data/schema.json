{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Berlin Music Map entity",
  "description": "One place where classical music can be taught or learned (music school, school with instrument classes, choir, wind band, piano school, conservatory...). Unknown fields are omitted rather than left empty. scripts/validate.py applies this schema plus cross-field rules (published offer needs a URL, an email needs its source page, the point must fall inside its district).",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "contact",
    "instruments",
    "offer",
    "contract",
    "email_language",
    "summary_en",
    "sources",
    "found_by",
    "last_verified"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "<district-slug>-<name-slug>"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "category": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}$",
      "description": "id from data/categories.json"
    },
    "secondary_categories": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,4}$"
      }
    },
    "district": {
      "type": "string",
      "enum": [
        "Mitte",
        "Friedrichshain-Kreuzberg",
        "Pankow",
        "Charlottenburg-Wilmersdorf",
        "Spandau",
        "Steglitz-Zehlendorf",
        "Tempelhof-Schöneberg",
        "Neukölln",
        "Treptow-Köpenick",
        "Marzahn-Hellersdorf",
        "Lichtenberg",
        "Reinickendorf"
      ]
    },
    "address": {
      "type": "object",
      "required": [
        "street",
        "postcode",
        "city"
      ],
      "properties": {
        "street": {
          "type": "string",
          "minLength": 3
        },
        "postcode": {
          "type": "string",
          "pattern": "^1[0-4][0-9]{3}$"
        },
        "city": {
          "type": "string",
          "enum": [
            "Berlin"
          ]
        }
      }
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "street": {
            "type": "string"
          },
          "postcode": {
            "type": "string",
            "pattern": "^1[0-4][0-9]{3}$"
          },
          "geo": {
            "type": "object",
            "required": [
              "lat",
              "lng",
              "precision",
              "source"
            ],
            "properties": {
              "lat": {
                "type": "number",
                "minimum": 52.33,
                "maximum": 52.68
              },
              "lng": {
                "type": "number",
                "minimum": 13.08,
                "maximum": 13.77
              },
              "precision": {
                "type": "string",
                "enum": [
                  "address",
                  "street",
                  "postcode"
                ]
              },
              "source": {
                "type": "string",
                "enum": [
                  "osm",
                  "nominatim",
                  "entity_site",
                  "postcode_centroid"
                ]
              }
            }
          }
        }
      }
    },
    "geo": {
      "type": "object",
      "required": [
        "lat",
        "lng",
        "precision",
        "source"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": 52.33,
          "maximum": 52.68
        },
        "lng": {
          "type": "number",
          "minimum": 13.08,
          "maximum": 13.77
        },
        "precision": {
          "type": "string",
          "enum": [
            "address",
            "street",
            "postcode"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "osm",
            "nominatim",
            "entity_site",
            "postcode_centroid"
          ]
        }
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "email_source_url": {
          "type": "string",
          "format": "uri"
        },
        "phone": {
          "type": "string"
        },
        "website": {
          "type": "string",
          "format": "uri"
        },
        "application_portal": {
          "type": "string",
          "format": "uri"
        },
        "email_obfuscated": {
          "type": "boolean"
        }
      }
    },
    "offer": {
      "type": "object",
      "required": [
        "status",
        "checked"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "posted",
            "initiative_welcome",
            "none_found"
          ]
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "published": {
          "type": "string",
          "format": "date"
        },
        "deadline": {
          "type": "string",
          "format": "date"
        },
        "checked": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "employment",
            "honorar_hourly",
            "honorar_commission",
            "freelance_project",
            "mixed",
            "unknown"
          ]
        },
        "evidence": {
          "type": "string",
          "description": "Literal phrase from the ad or website that proves the type"
        },
        "is_guess": {
          "type": "boolean",
          "description": "true if the type is inferred from the category rather than from a phrase in the source"
        }
      }
    },
    "conditions": {
      "type": "object",
      "properties": {
        "pay": {
          "type": "string"
        },
        "pay_unit": {
          "type": "string",
          "description": "EUR/45 min, EUR/60 min, EUR/month, EUR/service, EUR/project"
        },
        "pay_source_url": {
          "type": "string",
          "format": "uri"
        },
        "hours": {
          "type": "string"
        },
        "requirements": {
          "type": "string"
        },
        "german_level": {
          "type": "string",
          "enum": [
            "A2",
            "B1",
            "B2",
            "C1",
            "C2",
            "native"
          ]
        }
      }
    },
    "email_language": {
      "type": "string",
      "enum": [
        "de",
        "en",
        "es",
        "it"
      ]
    },
    "summary_en": {
      "type": "string",
      "minLength": 10,
      "maxLength": 400
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "nearest_station": {
      "type": "object",
      "required": [
        "name",
        "distance_m"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "distance_m": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "found_by": {
      "type": "string"
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "instruments": {
      "type": "array",
      "description": "Instrument families taught (see data/instruments.json); at least one",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "strings",
          "keyboard",
          "woodwind",
          "brass",
          "guitar_plucked",
          "accordion",
          "voice",
          "percussion"
        ]
      }
    },
    "instruments_detail": {
      "type": "array",
      "description": "Specific instruments as the school lists them, in English (e.g. 'violin', 'recorder', 'accordion')",
      "items": {
        "type": "string",
        "minLength": 2
      }
    }
  }
}